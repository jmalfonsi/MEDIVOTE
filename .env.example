# --- Configuration MediVote (serveur) ---

# Code administrateur. OBLIGATOIRE en production : le serveur refuse de démarrer sans lui.
# Il n'apparaît jamais dans le code envoyé au navigateur.
MEDIVOTE_ADMIN_PIN="582103"

# Port d'écoute (défaut : 3000).
PORT=3000

# Interface d'écoute (défaut : 0.0.0.0, toutes les interfaces).
MEDIVOTE_HOST=0.0.0.0

# Emplacement de la base de séance et de ses sauvegardes (défaut : ./data).
MEDIVOTE_DATA_DIR=/var/lib/medivote

# Passer à "true" dès que le service est servi en HTTPS : le cookie de session
# n'est alors plus transmis en clair.
MEDIVOTE_COOKIE_SECURE=false
