# --- Configuration MediVote (serveur) ---

# Code administrateur à 6 chiffres. OBLIGATOIRE en production : le serveur refuse
# de démarrer sans lui. Il n'apparaît jamais dans le code envoyé au navigateur.
#
# Ne reprenez PAS la valeur d'exemple ci-dessous, ni l'ancien code 582103 de la
# version de démonstration : il a longtemps été affiché en clair à l'écran et
# figure dans l'historique du dépôt. Tirez-en un au hasard :
#     python3 -c "import secrets; print(''.join(secrets.choice('0123456789') for _ in range(6)))"
MEDIVOTE_ADMIN_PIN="000000"

# Port d'écoute (défaut : 3000).
PORT=3000

# Interface d'écoute (défaut : 0.0.0.0, toutes les interfaces).
MEDIVOTE_HOST=0.0.0.0

# Emplacement de la base de séance et de ses sauvegardes (défaut : ./data).
MEDIVOTE_DATA_DIR=/var/lib/medivote

# Passer à "true" dès que le service est servi en HTTPS : le cookie de session
# n'est alors plus transmis en clair.
MEDIVOTE_COOKIE_SECURE=false

# Adresse publique inscrite dans les QR codes de vote. Elle doit être celle que
# les téléphones des membres savent joindre : le nom de domaine du reverse proxy,
# jamais l'adresse interne du service. À défaut, elle est déduite des en-têtes du
# proxy, ce qui suffit en développement mais pas en séance.
MEDIVOTE_URL_PUBLIQUE=https://medivote.exemple.fr
